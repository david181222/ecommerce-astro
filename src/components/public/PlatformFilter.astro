---
import type { Platform } from '../../types/game';

interface Props {
  platforms: Platform[];
  selectedPlatformId: string;
}

const { platforms, selectedPlatformId } = Astro.props;
---

<div class="w-full md:w-auto">
  <label class="sr-only" for="platform-select">Filtrar por plataforma</label>
  <select
    id="platform-select"
    name="platformId"
    onchange="this.form.submit()"
    aria-label="Filtrar por plataforma"
    class="w-full appearance-none border-b-2 border-[var(--ps-line)] bg-transparent px-0 py-2 pr-6 text-sm text-[var(--ps-white)] outline-none transition-colors focus:border-[var(--ps-blue)] md:w-auto"
  >
    <option value="">Todas las plataformas</option>
    {platforms.map((platform) => (
      <option value={platform.id} selected={platform.id === selectedPlatformId}>
        {platform.name}
      </option>
    ))}
  </select>
</div>
