---
import type { Genre } from '../../types/game';

interface Props {
  genres: Genre[];
  selectedGenreId: string;
}

const { genres, selectedGenreId } = Astro.props;
---

<div class="w-full md:w-auto">
  <label class="sr-only" for="genre-select">Filtrar por género</label>
  <select
    id="genre-select"
    name="genreId"
    onchange="this.form.submit()"
    aria-label="Filtrar por género"
    class="w-full appearance-none border-b-2 border-[var(--ps-line)] bg-transparent px-0 py-2 pr-6 text-sm text-[var(--ps-white)] outline-none transition-colors focus:border-[var(--ps-blue)] md:w-auto"
  >
    <option value="">Todos los géneros</option>
    {genres.map((genre) => (
      <option value={genre.id} selected={genre.id === selectedGenreId}>
        {genre.name}
      </option>
    ))}
  </select>
</div>
