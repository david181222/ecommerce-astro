---
import type { GameListItem } from '../../types/game';

interface Props {
  game: GameListItem;
}

const { game } = Astro.props;
const priceLabel = new Intl.NumberFormat('es-CO', {
  style: 'currency',
  currency: 'COP',
}).format(game.price);
const genres = game.genres.slice(0, 2);
const platforms = game.platforms.slice(0, 2);
---

<article
  role="article"
  class="h-full overflow-visible rounded-2xl border border-[var(--ps-border)] bg-[var(--ps-surface)] transition-all duration-200 hover:border-[var(--ps-blue-light)] hover:shadow-[0_20px_40px_-24px_var(--ps-blue)]"
>
  <a
    href={`/games/${game.id}`}
    class="block overflow-hidden rounded-t-2xl"
  >
    <img
      src={game.image_url ?? '/placeholder-game.jpg'}
      alt={game.name}
      class="aspect-[4/3] w-full object-cover transition-transform hover:scale-105 sm:aspect-square"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="flex h-full flex-col gap-2 p-4">
    <a href={`/games/${game.id}`} class="block">
      <div class="flex items-start justify-between gap-3">
        <h2 class="text-base font-bold leading-tight text-[var(--ps-text)]">
          {game.name}
        </h2>
        <span class="shrink-0 text-lg font-bold text-[var(--ps-green)]">
          {priceLabel}
        </span>
      </div>
    </a>
    <p class="text-sm text-[var(--ps-muted)]">
      {game.developer?.name ?? 'Desconocido'}
    </p>
    <div class="flex flex-wrap gap-2">
      {genres.map((genre) => (
        <span class="rounded-full border border-[color:color-mix(in_srgb,var(--ps-blue-light)_40%,transparent)] bg-[color:color-mix(in_srgb,var(--ps-blue)_30%,transparent)] px-2 py-0.5 text-xs text-[var(--ps-blue-light)]">
          {genre.name}
        </span>
      ))}
      {platforms.map((platform) => (
        <span class="rounded-full bg-[color:color-mix(in_srgb,var(--ps-text)_5%,transparent)] px-2 py-0.5 text-xs text-[var(--ps-muted)]">
          {platform.name}
        </span>
      ))}
    </div>
    <div class="mt-2 flex gap-2">
      <button
        type="button"
        class="flex-1 cursor-pointer rounded-xl bg-[var(--ps-blue)] px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-[var(--ps-blue-light)]"
      >
        Comprar
      </button>
      <button
        type="button"
        class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-xl border border-[var(--ps-border)] bg-[var(--ps-surface-2)] text-base text-[var(--ps-text)] transition-colors hover:border-[var(--ps-blue)] hover:bg-[var(--ps-border)]"
        aria-label="Añadir al carrito"
      >
        🛒
      </button>
    </div>
  </div>
</article>
