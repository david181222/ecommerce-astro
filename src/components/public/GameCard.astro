---
import type { GameListItem } from '../../types/game';

interface Props {
  game: GameListItem;
}

const { game } = Astro.props;
const priceLabel = new Intl.NumberFormat('es-CO', {
  style: 'currency',
  currency: 'COP',
}).format(game.price);
const genres = game.genres.slice(0, 2);
const platforms = game.platforms.slice(0, 2);
const imageUrl = game.image_url ?? '/placeholder-game.jpg';
---

<article
  role="article"
  class="group flex h-full flex-col overflow-hidden rounded border border-[var(--ps-line)] bg-[var(--ps-surface)] transition-colors duration-150 hover:border-[var(--ps-blue)]"
>
  <a href={`/games/${game.id}`} class="block overflow-hidden">
    <img
      src={imageUrl}
      alt={game.name}
      class="aspect-[3/4] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="h-[2px] w-0 bg-[var(--ps-blue)] transition-all duration-300 group-hover:w-full"></div>
  <div class="flex flex-1 flex-col gap-2 p-3">
    <div class="flex items-start justify-between gap-2">
      <a
        href={`/games/${game.id}`}
        class="line-clamp-2 text-sm font-bold leading-tight text-[var(--ps-white)] transition-colors hover:text-[var(--ps-blue-bright)]"
      >
        {game.name}
      </a>
      <span class="whitespace-nowrap text-sm font-black text-[var(--ps-price)]">
        {priceLabel}
      </span>
    </div>

    <p class="text-xs text-[var(--ps-muted)]">
      {game.developer?.name ?? 'Desconocido'}
    </p>

    <div class="mt-auto flex flex-wrap gap-1">
      {genres.map((genre, index) => (
        <span class={`badge-genre-${index % 4}`}>{genre.name}</span>
      ))}
      {platforms.map((platform) => (
        <span class="badge-platform">{platform.name}</span>
      ))}
    </div>

    <div class="mt-2 flex gap-2">
      <button
        type="button"
        class="flex-1 cursor-pointer rounded-sm bg-[var(--ps-blue)] py-2 text-xs font-bold uppercase tracking-wider text-[var(--ps-white)] transition-colors hover:bg-[var(--ps-blue-bright)]"
      >
        Comprar
      </button>
      <button
        type="button"
        aria-label="Añadir al carrito"
        data-cart-button
        data-cart-id={game.id}
        data-cart-name={game.name}
        data-cart-price={String(game.price)}
        data-cart-image={imageUrl}
        class="flex w-9 cursor-pointer items-center justify-center rounded-sm border border-[var(--ps-line)] bg-[var(--ps-surface-2)] text-sm text-[var(--ps-white)] transition-colors hover:border-[var(--ps-blue)] hover:bg-[var(--ps-line)]"
      >
        🛒
      </button>
    </div>
  </div>
</article>
