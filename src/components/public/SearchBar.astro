---
interface Props {
  search: string;
  action?: string;
}

const { search, action } = Astro.props;
const formAction = action ?? '/games';
// GET mantiene los filtros en la URL: compartible y sin JS de cliente.
---

<form
  method="GET"
  action={formAction}
  role="search"
  class="flex w-full flex-col gap-3 md:flex-row md:flex-wrap md:items-center"
>
  <input
    type="search"
    name="search"
    value={search}
    placeholder="Buscar juegos..."
    class="w-full rounded-xl border border-[var(--ps-border)] bg-[var(--ps-bg)] px-4 py-2 text-sm text-[var(--ps-text)] placeholder:text-[var(--ps-muted)] outline-none transition-colors focus:border-[var(--ps-blue-light)] md:flex-1"
  />
  <slot />
  <button
    type="submit"
    class="rounded-xl bg-[var(--ps-blue)] px-6 py-2 text-sm font-bold text-[var(--ps-text)] transition-colors hover:bg-[var(--ps-blue-light)]"
  >
    Buscar
  </button>
</form>
