---
interface Props {
  search: string;
  action?: string;
}

const { search, action } = Astro.props;
const formAction = action ?? '/games';
// GET mantiene los filtros en la URL: compartible y sin JS de cliente.
---

<form
  method="GET"
  action={formAction}
  role="search"
  class="flex w-full flex-col gap-3 md:flex-row md:flex-wrap md:items-center"
>
  <input
    type="search"
    name="search"
    value={search}
    placeholder="Buscar juegos..."
    class="w-full border-b-2 border-[var(--ps-line)] bg-transparent px-0 py-2 text-sm text-[var(--ps-white)] placeholder:text-[var(--ps-muted)] outline-none transition-colors focus:border-[var(--ps-blue)] md:flex-1"
  />
  <slot />
  <button
    type="submit"
    class="cursor-pointer rounded-sm bg-[var(--ps-blue)] px-6 py-2 text-xs font-bold uppercase tracking-widest text-[var(--ps-white)] transition-colors hover:bg-[var(--ps-blue-bright)]"
  >
    Buscar
  </button>
</form>
