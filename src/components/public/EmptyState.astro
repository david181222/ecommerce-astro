---
interface Props {
  title?: string;
  message?: string;
  showReset?: boolean;
}

const {
  title = 'Sin resultados',
  message = 'No encontramos juegos con esos filtros.',
  showReset = false,
} = Astro.props;
---

<div class="py-20 text-center">
  <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center text-[var(--ps-line)]">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-10 w-10"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
    </svg>
  </div>
  <h2 class="text-xl font-bold text-[var(--ps-white)]">{title}</h2>
  <p class="mt-2 text-sm text-[var(--ps-muted)]">{message}</p>
  {showReset && (
    <a
      href="/games"
      class="mt-6 inline-flex items-center justify-center rounded-sm bg-[var(--ps-blue)] px-6 py-3 text-xs font-bold uppercase tracking-wider text-[var(--ps-white)] transition-colors hover:bg-[var(--ps-blue-bright)]"
    >
      Ver todos los juegos
    </a>
  )}
</div>
