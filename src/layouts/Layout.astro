---
import '../styles/global.css';

const { title } = Astro.props;
const pageTitle = title ? `${title} | GameStation` : 'GameStation';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body class="bg-[var(--ps-bg)] font-sans text-[var(--ps-white)]">
		<header class="border-b border-[var(--ps-line)] bg-[var(--ps-bg)]">
			<div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 md:px-8">
				<a href="/" class="text-lg font-black tracking-tight">
					<span class="text-[var(--ps-white)]">Game</span><span class="text-[var(--ps-blue)]">Station</span>
				</a>
				<nav class="hidden items-center gap-6 text-sm font-medium uppercase tracking-widest text-[var(--ps-muted)] md:flex">
					<a href="/games" class="transition-colors hover:text-[var(--ps-white)]">
						Catálogo
					</a>
					<a href="/login" class="transition-colors hover:text-[var(--ps-white)]">
						Administrar
					</a>
				</nav>
			</div>
		</header>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
