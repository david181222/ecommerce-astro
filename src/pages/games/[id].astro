---
// SSR explícito: el detalle puede cambiar sin necesidad de rebuild.
export const prerender = false;

import EmptyState from '../../components/public/EmptyState.astro';
import Layout from '../../layouts/Layout.astro';
import { getGameById } from '../../services/games.server';
import type { Game } from '../../types/game';

const { id } = Astro.params;

if (!id) {
  // 404 real para SEO/Cloudflare; un redirect devolvería 302 + 200.
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

let game: Game | null = null;
let errorMsg = '';

// Aislamos fallos de Supabase para mostrar un estado controlado.
try {
  game = await getGameById(id);
} catch (error) {
  console.error(`[/games/${id}] Error:`, error);
  errorMsg = 'No pudimos cargar este juego.';
}

if (!game && !errorMsg) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<Layout title={game?.name ?? 'Juego no encontrado'}>
  <main class="mx-auto max-w-4xl px-4 py-8 md:px-8">
    <!-- Boton volver -->
    <a
      href="/games"
      class="inline-flex items-center text-xs font-bold uppercase tracking-widest text-[var(--ps-blue-bright)] transition-colors hover:text-[var(--ps-white)]"
    >
      &larr; Volver al catálogo
    </a>

    <!-- Estado de error -->
    {errorMsg && <EmptyState title="Error" message={errorMsg} />}

    <!-- Detalle del juego -->
    {game && (
      <article class="mt-6">
        <div class="relative mb-6">
          <img
            src={game.image_url ?? '/placeholder-game.jpg'}
            alt={game.name}
            class="max-h-[400px] w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--ps-bg)] via-transparent to-transparent"></div>
          <h1 class="absolute bottom-4 left-4 text-2xl font-black uppercase tracking-tight text-[var(--ps-white)] md:bottom-6 md:left-6">
            {game.name}
          </h1>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          <div class="md:col-span-2">
            <p class="leading-relaxed text-[var(--ps-muted)]">
              {game.description ?? 'Sin descripción disponible.'}
            </p>
          </div>

          <div class="md:col-span-1">
            <span class="text-3xl font-black text-[var(--ps-price)]">
              ${game.price.toFixed(2)}
            </span>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-6 border-t border-[var(--ps-line)] pt-6">
          {game.developer && (
            <div class="min-w-[160px] border-r border-[var(--ps-line)] pr-6 last:border-r-0 last:pr-0">
              <span class="text-[10px] uppercase tracking-widest text-[var(--ps-muted)]">
                Desarrollador
              </span>
              <p class="mt-1 text-sm font-bold text-[var(--ps-white)]">
                {game.developer.name}
              </p>
            </div>
          )}

          {game.release_date && (
            <div class="min-w-[160px] border-r border-[var(--ps-line)] pr-6 last:border-r-0 last:pr-0">
              <span class="text-[10px] uppercase tracking-widest text-[var(--ps-muted)]">
                Lanzamiento
              </span>
              <p class="mt-1 text-sm font-bold text-[var(--ps-white)]">
                {new Date(game.release_date).toLocaleDateString('es-CO', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
            </div>
          )}

          {game.genres.length > 0 && (
            <div class="min-w-[160px] border-r border-[var(--ps-line)] pr-6 last:border-r-0 last:pr-0">
              <span class="text-[10px] uppercase tracking-widest text-[var(--ps-muted)]">
                Géneros
              </span>
              <div class="mt-2 flex flex-wrap gap-1">
                {game.genres.map((genre, index) => (
                  <a
                    href={`/games?genreId=${genre.id}`}
                    class={`badge-genre-${index % 4}`}
                  >
                    {genre.name}
                  </a>
                ))}
              </div>
            </div>
          )}

          {game.platforms.length > 0 && (
            <div class="min-w-[160px] border-r border-[var(--ps-line)] pr-6 last:border-r-0 last:pr-0">
              <span class="text-[10px] uppercase tracking-widest text-[var(--ps-muted)]">
                Plataformas
              </span>
              <div class="mt-2 flex flex-wrap gap-1">
                {game.platforms.map((platform) => (
                  <span class="badge-platform">{platform.name}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </article>
    )}
  </main>
</Layout>
