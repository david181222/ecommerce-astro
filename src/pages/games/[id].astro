---
// SSR explícito: el detalle puede cambiar sin necesidad de rebuild.
export const prerender = false;

import EmptyState from '../../components/public/EmptyState.astro';
import Layout from '../../layouts/Layout.astro';
import { getGameById } from '../../services/games.server';
import type { Game } from '../../types/game';

const { id } = Astro.params;

if (!id) {
  // 404 real para SEO/Cloudflare; un redirect devolvería 302 + 200.
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

let game: Game | null = null;
let errorMsg = '';

// Aislamos fallos de Supabase para mostrar un estado controlado.
try {
  game = await getGameById(id);
} catch (error) {
  console.error(`[/games/${id}] Error:`, error);
  errorMsg = 'No pudimos cargar este juego.';
}

if (!game && !errorMsg) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<Layout title={game?.name ?? 'Juego no encontrado'}>
  <main class="mx-auto max-w-4xl px-4 py-8 md:px-8">
    <!-- Boton volver -->
    <a
      href="/games"
      class="inline-flex items-center text-sm font-semibold text-[var(--ps-blue-light)] transition-colors hover:text-[var(--ps-text)]"
    >
      &larr; Volver al catálogo
    </a>

    <!-- Estado de error -->
    {errorMsg && <EmptyState title="Error" message={errorMsg} />}

    <!-- Detalle del juego -->
    {game && (
      <article class="mt-6">
        <div class="relative mb-6 overflow-hidden rounded-2xl">
          <img
            src={game.image_url ?? '/placeholder-game.jpg'}
            alt={game.name}
            class="w-full max-h-80 object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--ps-bg)] to-transparent"></div>
        </div>

        <div class="grid gap-8 md:grid-cols-3">
          <div class="md:col-span-2">
            <h1 class="mb-3 text-2xl font-bold tracking-tight text-[var(--ps-text)]">
              {game.name}
            </h1>
            <p class="leading-relaxed text-[var(--ps-muted)]">
              {game.description ?? 'Sin descripción disponible.'}
            </p>
          </div>

          <div class="md:col-span-1">
            <span class="text-3xl font-bold text-[var(--ps-green)]">
              ${game.price.toFixed(2)}
            </span>
          </div>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-6 rounded-2xl border border-[var(--ps-border)] bg-[var(--ps-surface-2)] p-6 md:grid-cols-4">
          {game.developer && (
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-[var(--ps-muted)]">
                Desarrollador
              </span>
              <p class="mt-1 text-sm text-[var(--ps-text)]">
                {game.developer.name}
              </p>
            </div>
          )}

          {game.release_date && (
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-[var(--ps-muted)]">
                Lanzamiento
              </span>
              <p class="mt-1 text-sm text-[var(--ps-text)]">
                {new Date(game.release_date).toLocaleDateString('es-CO', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
            </div>
          )}

          {game.genres.length > 0 && (
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-[var(--ps-muted)]">
                Géneros
              </span>
              <div class="mt-1 flex flex-wrap gap-2">
                {game.genres.map((genre) => (
                  <a
                    href={`/games?genreId=${genre.id}`}
                    class="rounded-full border border-[var(--ps-blue)] bg-[color:color-mix(in_srgb,var(--ps-blue)_20%,transparent)] px-3 py-1 text-xs text-[var(--ps-blue-light)] transition-colors hover:bg-[var(--ps-blue)] hover:text-[var(--ps-text)]"
                  >
                    {genre.name}
                  </a>
                ))}
              </div>
            </div>
          )}

          {game.platforms.length > 0 && (
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-[var(--ps-muted)]">
                Plataformas
              </span>
              <div class="mt-1 flex flex-wrap gap-2">
                {game.platforms.map((platform) => (
                  <span class="rounded-full bg-[color:color-mix(in_srgb,var(--ps-text)_5%,transparent)] px-3 py-1 text-xs text-[var(--ps-muted)]">
                    {platform.name}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </article>
    )}
  </main>
</Layout>
