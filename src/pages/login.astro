---
import "../styles/global.css";

// Archivo: pagina de login del admin.

export const prerender = true;

const pageTitle = "Login | Admin";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-[var(--ps-bg)] font-sans text-[var(--ps-white)]">
    <main class="flex min-h-screen items-center justify-center px-4 py-12">
      <section class="w-full max-w-md rounded border border-[var(--ps-line)] bg-[var(--ps-surface)] p-8">
        <div class="mb-6">
          <p class="text-sm uppercase tracking-[0.3em] text-[var(--ps-muted)]">Admin</p>
          <h1 class="mt-3 text-2xl font-black uppercase tracking-tight">Acceso a la consola</h1>
          <p class="mt-2 text-sm text-[var(--ps-muted)]">
            Inicia sesi&oacute;n para administrar el cat&aacute;logo.
          </p>
        </div>
        <form id="login-form" class="space-y-4">
          <div>
            <label for="email" class="text-xs font-semibold uppercase text-[var(--ps-muted)]">
              Email
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-2 w-full rounded-sm border border-[var(--ps-line)] bg-[var(--ps-surface-2)] px-3 py-2 text-sm text-[var(--ps-white)] outline-none transition focus:border-[var(--ps-blue)]"
              placeholder="admin@tienda.com"
            />
          </div>
          <div>
            <label
              for="password"
              class="text-xs font-semibold uppercase text-[var(--ps-muted)]"
            >
              Contrase&ntilde;a
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              class="mt-2 w-full rounded-sm border border-[var(--ps-line)] bg-[var(--ps-surface-2)] px-3 py-2 text-sm text-[var(--ps-white)] outline-none transition focus:border-[var(--ps-blue)]"
              placeholder="********"
            />
          </div>
          <button
            id="login-submit"
            type="submit"
            class="flex w-full cursor-pointer items-center justify-center rounded-sm bg-[var(--ps-blue)] px-4 py-3 text-xs font-bold uppercase tracking-widest text-[var(--ps-white)] transition hover:bg-[var(--ps-blue-bright)]"
          >
            Entrar
          </button>
          <p id="login-error" class="hidden rounded border border-[var(--ps-circle)]/40 bg-[var(--ps-circle)]/10 px-3 py-2 text-sm text-[var(--ps-white)]"></p>
        </form>
      </section>
    </main>

    <script>
      import { supabaseBrowser } from "../lib/supabaseBrowser";

      const form = document.getElementById("login-form");
      const errorEl = document.getElementById("login-error");
      const submitBtn = document.getElementById("login-submit");

      /**
       * Muestra u oculta el error en el formulario.
       * Recibe message string.
       * No devuelve valor.
       */
      const setError = (message) => {
        if (!errorEl) return;
        if (!message) {
          errorEl.textContent = "";
          errorEl.classList.add("hidden");
          return;
        }
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");
      };

      /**
       * Cambia el estado del boton submit.
       * Recibe isLoading boolean.
       * No devuelve valor.
       */
      const setLoading = (isLoading) => {
        if (!submitBtn) return;
        if (isLoading) {
          submitBtn.setAttribute("disabled", "true");
          submitBtn.classList.add("opacity-60", "cursor-not-allowed");
          submitBtn.textContent = "Ingresando...";
          return;
        }
        submitBtn.removeAttribute("disabled");
        submitBtn.classList.remove("opacity-60", "cursor-not-allowed");
        submitBtn.textContent = "Entrar";
      };

      /**
       * Redirige si ya existe sesion activa.
       * No recibe parametros.
       * No devuelve valor.
       */
      const redirectIfSession = async () => {
        const supabase = supabaseBrowser();
        const { data } = await supabase.auth.getSession();
        if (data.session) {
          window.location.href = "/admin";
        }
      };

      redirectIfSession();

      // Login con Supabase Auth y feedback en UI.
      if (form) {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          setError("");
          setLoading(true);

          const formData = new FormData(form);
          const email = String(formData.get("email") || "");
          const password = String(formData.get("password") || "");

          const supabase = supabaseBrowser();
          const { error } = await supabase.auth.signInWithPassword({
            email,
            password,
          });

          if (error) {
            setError(error.message);
            setLoading(false);
            return;
          }

          window.location.href = "/admin";
        });
      }
    </script>
  </body>
</html>
