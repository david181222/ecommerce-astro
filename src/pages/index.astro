---
import GameCard from '../components/public/GameCard.astro';
import Layout from '../layouts/Layout.astro';
import { listGames } from '../services/games.server';
import type { GameListItem } from '../types/game';

let featuredGames: GameListItem[] = [];

try {
	const { items } = await listGames({ pageSize: 4 });
	featuredGames = items;
} catch (error) {
	console.error('[/] Error fetching featured games:', error);
	featuredGames = [];
}
---

<Layout>
	<main class="mx-auto max-w-6xl px-4 py-10 md:px-8">
		<section class="mb-12 rounded border border-[var(--ps-line)] bg-[var(--ps-surface)] p-10">
			<p class="text-xs uppercase tracking-[0.35em] text-[var(--ps-muted)]">
				Play the catalog
			</p>
			<h1 class="mt-3 text-3xl font-black uppercase tracking-tight text-[var(--ps-white)]">
				Ecommerce GameStation
			</h1>
			<p class="mt-3 text-base text-[var(--ps-muted)]">
				Descubre tu próximo juego favorito en nuestro catálogo.
			</p>
			<a
				href="/games"
				class="mt-6 inline-flex items-center justify-center rounded-sm bg-[var(--ps-blue)] px-8 py-3 text-xs font-bold uppercase tracking-widest text-[var(--ps-white)] transition-colors hover:bg-[var(--ps-blue-bright)]"
			>
				Ver catálogo
			</a>
		</section>

		{featuredGames.length > 0 && (
			<section class="space-y-6">
				<div class="flex items-center justify-between">
					<h2 class="border-b-2 border-[var(--ps-blue)] pb-2 text-2xl font-black uppercase tracking-tight text-[var(--ps-white)]">
						Destacados
					</h2>
					<a
						href="/games"
						class="text-xs font-bold uppercase tracking-widest text-[var(--ps-blue-bright)] transition-colors hover:text-[var(--ps-white)]"
					>
						Ver todo
					</a>
				</div>
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{featuredGames.map((game) => (
						<GameCard game={game} />
					))}
				</div>
			</section>
		)}
	</main>
</Layout>
